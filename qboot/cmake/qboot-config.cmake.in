# qboot-config.cmake —— find_package(qboot) 用
#
#   find_package(qboot REQUIRED)
#   target_link_libraries(my_svc PRIVATE
#       qboot::q_http qboot::q_mapper qboot::q_reg qboot::q_db qboot::q_core)
#
# 后缀带 _shared 的是动态库版本，如 qboot::q_core_shared。
# 静态库默认，想用动态库就把每个名字都换成 _shared。

set(qboot_VERSION "@PROJECT_VERSION@")

get_filename_component(_qboot_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(QBOOT_INCLUDE_DIR "${_qboot_prefix}/include")
set(QBOOT_LIBRARY_DIR "${_qboot_prefix}/lib")

# 依赖顺序（依赖者在前）。用空格分隔依赖——不能用分号，
# CMake 的 list 以分号分隔元素，写 "q_log;q_core" 会被拆成两个条目。
set(_qboot_deps
    "q_core"
    "q_log q_core"
    "q_conf q_core"
    "q_db q_core q_log"
    "q_db_mock q_db"
    "q_db_mysql q_db"
    "q_httpc q_core"
    "q_mapper q_db q_log q_core"
    "q_reg q_httpc q_core q_log"
    "q_http q_log q_core"
)

foreach(_entry IN LISTS _qboot_deps)
    string(REPLACE " " ";" _parts "${_entry}")
    list(LENGTH _parts _n)
    if(_n EQUAL 0)
        continue()
    endif()
    list(GET _parts 0 _name)
    set(_deps "")
    if(_n GREATER 1)
        math(EXPR _last "${_n} - 1")
        foreach(_i RANGE 1 ${_last})
            list(GET _parts ${_i} _d)
            list(APPEND _deps "${_d}")
        endforeach()
    endif()

    foreach(_variant "" "_shared")
        set(_t "qboot::${_name}${_variant}")
        if(TARGET ${_t})
            continue()
        endif()

        if(_variant STREQUAL "")
            set(_file "${QBOOT_LIBRARY_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}${_name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
            set(_type STATIC)
        else()
            set(_file "${QBOOT_LIBRARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}${_name}${CMAKE_SHARED_LIBRARY_SUFFIX}")
            set(_type SHARED)
        endif()

        if(NOT EXISTS "${_file}")
            continue()
        endif()

        add_library(${_t} ${_type} IMPORTED)
        set_target_properties(${_t} PROPERTIES
            IMPORTED_LOCATION "${_file}"
            INTERFACE_INCLUDE_DIRECTORIES "${QBOOT_INCLUDE_DIR}")

        if(_deps)
            set(_mapped "")
            foreach(_d IN LISTS _deps)
                list(APPEND _mapped "qboot::${_d}${_variant}")
            endforeach()
            set_property(TARGET ${_t} APPEND PROPERTY
                INTERFACE_LINK_LIBRARIES ${_mapped})
        endif()

        # 静态库还要带上传递的系统依赖
        if(_variant STREQUAL "")
            set_property(TARGET ${_t} APPEND PROPERTY
                INTERFACE_LINK_LIBRARIES @QBOOT_CONFIG_SYS_LIBS@)
        endif()
    endforeach()
endforeach()

unset(_qboot_deps)
unset(_entry)
unset(_name)
unset(_file)
